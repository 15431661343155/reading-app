<?xml version="1.0" encoding="utf-8"?>
<resources>
    <item name="tag_bg_color" type="id" />
    <!-- 打了该 tag 的 View 及其子树不参与「跟随背景色」重着色（如背景色块本身必须显示真实颜色） -->
    <item name="tag_keep_own_color" type="id" />
    <!-- 文字在派生配色中的角色（1=主文字 2=次文字 0=不归管）；逐帧渐变时按角色取色，避免中间灰阶被误判 -->
    <item name="tag_theme_text_role" type="id" />
    <!-- 系统栏出血：inset 叠加前的原始 padding / 高度，保证重复注册监听不会累加 -->
    <item name="tag_bar_base_top" type="id" />
    <item name="tag_bar_base_bottom" type="id" />
    <item name="tag_bar_base_height" type="id" />
    <!-- BaseActivity#onContentChanged 认的头部 id 之一：toolbar_back（全站 MaterialToolbar）／layout_header
         之外，顶部不是工具栏的页面把自己的头部容器标成 app_header，色带就会铺到状态栏底下 -->
    <item name="app_header" type="id" />
</resources>