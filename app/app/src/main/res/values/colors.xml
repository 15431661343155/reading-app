    <!-- ===== 「宣纸」配色风格 · 全 App 皮肤 token =====
         由弹窗家族（gf_*）那套宣纸底 / 墨字 / 描金 / 朱砂扩到整站。
         凡是与弹窗取值完全相同的项直接别名到 gf_*，让「同一套色」这层关系写死在资源里；
         弹窗没有对应语义的（页面底、色带、底栏磨砂）才给独立值。夜间值见 values-night/colors.xml。 -->
    <color name="xz_page_bg">#FFF6EFE0</color>         <!-- 页面底：宣纸，比卡片深一档好浮起 -->
    <color name="xz_surface">@color/gf_card_top</color><!-- 抬起面 #FFFCF4 -->
    <color name="xz_card">@color/gf_card_top</color>   <!-- 卡片面 #FFFCF4 -->
    <color name="xz_card_soft">#FFFBF5E7</color>       <!-- 卡内芯片底：比卡片略深一点的米 -->
    <color name="xz_text_primary">@color/gf_ink</color>
    <color name="xz_text_secondary">@color/gf_body</color>
    <color name="xz_text_tertiary">@color/gf_hint</color>
    <color name="xz_separator">#FFEADFC4</color>       <!-- 分隔线：描金压淡 -->
