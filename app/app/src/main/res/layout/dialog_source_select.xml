<?xml version="1.0" encoding="utf-8"?>
<!-- 外站书城 书源选择弹窗。
     列表 / 骨架 / 失败重试三种状态都在弹窗内部切换（不再借用背后书城页的 SwipeRefreshLayout），
     底部按钮条用皮肤化 TextView 按钮，替掉 AlertDialog 原生按钮区。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="16dp">

    <!-- 顶部：标题 + 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择外站书源"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/appTextPrimary"/>

        <ImageView
            android:id="@+id/iv_dialog_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close_grey"
            android:contentDescription="@null"
            android:padding="4dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="书城将展示所选书源的分类、榜单与推荐"
        android:textSize="12sp"
        android:textColor="?attr/appTextSecondary"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="236dp">

        <!-- 状态 1：书源列表 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_source_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/appCardSoft"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/appSeparator"
            app:strokeWidth="0.5dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_source_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- 状态 2：拉取中骨架屏 -->
        <LinearLayout
            android:id="@+id/ll_source_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/item_source_skeleton"/>
            <include layout="@layout/item_source_skeleton"/>
            <include layout="@layout/item_source_skeleton"/>
        </LinearLayout>

        <!-- 状态 3：拉取失败 -->
        <LinearLayout
            android:id="@+id/ll_source_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_source_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="获取书源列表失败"
                android:textSize="13sp"
                android:textColor="?attr/appTextSecondary"/>

            <TextView
                android:id="@+id/tv_source_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_gf_field"
                android:paddingHorizontal="18dp"
                android:paddingVertical="7dp"
                android:text="重试"
                android:textSize="13sp"
                android:textColor="?attr/appTextPrimary"/>
        </LinearLayout>
    </FrameLayout>

    <!-- 底部：已选回显 + 取消 / 确认 -->
    <LinearLayout
        android:id="@+id/ll_source_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="13dp">

        <TextView
            android:id="@+id/tv_source_selected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="请选择一个书源"
            android:textSize="12sp"
            android:textColor="?attr/appTextSecondary"/>

        <TextView
            android:id="@+id/tv_source_cancel"
            android:layout_width="76dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_gf_field"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="取消"
            android:textSize="14sp"
            android:textColor="?attr/appTextSecondary"/>

        <TextView
            android:id="@+id/tv_source_confirm"
            android:layout_width="92dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_gf_btn_primary"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="确认"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/appOnAccent"/>
    </LinearLayout>
</LinearLayout>
