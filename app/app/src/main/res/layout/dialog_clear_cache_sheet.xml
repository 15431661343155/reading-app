<?xml version="1.0" encoding="utf-8"?>
<!--
  清理缓存 · 底部抽屉。

  结构：遮罩（dim_cache）→ 面板（sheet_panel_clear，白底 18dp 顶圆角）
  面板内自上而下：抓手条（纯视觉）、标题、
  体积大字、明细清单（box_cache_items，代码动态填充）、本地书说明、按钮行。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dim_cache"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      遮罩独立成 View（而不是挂在根 FrameLayout 的 background 上）：
      跟手拖拽时直接 setAlpha 作用在这个 View 上，比改 background Drawable 的
      alpha 更可靠 —— 后者依赖 Drawable.mutate() 是否真的返回了副本。
    -->
    <View
        android:id="@+id/v_cache_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#73000000" />

    <!--
      面板不设 android:clickable —— 由 MineFragment#setupSheetDrag 给它挂一个
      OnTouchListener 来消费触摸。原因是 clickable 会让 View 走 onTouchEvent 而
      setPressed(true)，再经 ViewGroup.dispatchSetPressed **把按下态传播给所有
      不可点击的子节点**（本页里的 btn_select_all、以及体积为 0 被 setClickable(false)
      的明细行），于是点面板空白会把它们一起点亮成灰。走 OnTouchListener 消费则
      完全不触发 onTouchEvent，也就没有按下态、没有传播。
      另：面板内所有非交互区（标题、体积大字框、说明、按钮间隙、内边距）的触摸都需要
      被面板吃掉，否则会穿透到底层兄弟 v_cache_dim（它挂着"点击关闭"）。
    -->
    <LinearLayout
        android:id="@+id/sheet_panel_clear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet_top_rounded"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="22dp">

        <!-- 抓手条：纯视觉提示，起手拖拽由面板自身处理（见 MineFragment#setupSheetDrag） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <View
                android:layout_width="36dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_sheet_grabber" />
        </LinearLayout>

        <!-- 标题区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_about_icon_tile"
                android:padding="8dp"
                android:src="@drawable/ic_delete"
                app:tint="?attr/appAccent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mine_clear_cache"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/mine_cache_sheet_sub"
                    android:textColor="?attr/appTextSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 体积大字 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cache_total_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tv_cache_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="?attr/appTextPrimary"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tv_cache_total_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:includeFontPadding="false"
                android:text="@string/mine_cache_unit_idle"
                android:textColor="?attr/appTextSecondary"
                android:textSize="12.5sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_cache_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cache_count_pill"
                android:paddingStart="9dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp"
                android:textColor="?attr/appAccent"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- 清单标题 + 全选 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingTop="14dp"
            android:paddingEnd="2dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mine_cache_items_label"
                android:textColor="?attr/appTextSecondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/btn_select_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/iv_select_all"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/sel_cache_checkbox_small" />

                <TextView
                    android:id="@+id/tv_select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/mine_cache_select_all"
                    android:textColor="?attr/appAccent"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 明细清单：代码动态填充 -->
        <LinearLayout
            android:id="@+id/box_cache_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="vertical" />

        <!-- 本地书说明 -->
        <LinearLayout
            android:id="@+id/box_cache_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_cache_total_box"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="11dp"
            android:paddingEnd="12dp"
            android:paddingBottom="11dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="1dp"
                android:src="@drawable/ic_info_outline"
                app:tint="?attr/appTextSecondary" />

            <TextView
                android:id="@+id/tv_cache_local_note"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/appTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_cache_cancel"
                android:layout_width="108dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_capsule_gray"
                android:gravity="center"
                android:text="@string/mine_cancel"
                android:textColor="?attr/appTextPrimary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btn_cache_confirm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="@string/mine_cache_clear_all"
                android:textColor="?attr/appOnAccent"
                android:textSize="16.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
