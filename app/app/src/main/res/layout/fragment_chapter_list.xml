<?xml version="1.0" encoding="utf-8"?>
<!--目录Fragment布局（iOS 浅色磨砂玻璃风）-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ios_bg">

    <!-- 书籍信息头部（iOS 卡片风：白底大标题） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/ios_bg"
        android:gravity="center_vertical">

        <!-- 封面 -->
        <ImageView
            android:id="@+id/iv_book_cover"
            android:layout_width="70dp"
            android:layout_height="95dp"
            android:src="@drawable/ic_detective"
            android:scaleType="centerCrop"
            android:background="@color/ios_bg_grouped"
            android:contentDescription="封面" />

        <!-- 书名和作者 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="15dp">

            <TextView
                android:id="@+id/tv_header_book_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="书名"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/ios_text_primary" />

            <TextView
                android:id="@+id/tv_header_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="作者"
                android:textSize="14sp"
                android:textColor="@color/ios_text_secondary"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_chapter_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="共 0 章"
                android:textSize="12sp"
                android:textColor="@color/ios_text_tertiary"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- 正序/倒序切换按钮 -->
        <ImageView
            android:id="@+id/iv_sort_order"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="6dp"
            android:src="@drawable/ic_sort_asc"
            app:tint="@color/ios_text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="切换排序" />

    </LinearLayout>

    <!-- 分割线（iOS 0.5dp 规范） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/ios_separator" />

    <!-- 章节列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chapters"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
