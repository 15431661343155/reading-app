<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top_rounded"
    android:clipToOutline="true"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <!-- 标题（收起图标左上） -->
    <LinearLayout
        android:id="@+id/popup_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/iv_font_popup_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/shouqi"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="收起" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择字体"
            android:textSize="18sp"
            android:textColor="@color/ios_text_primary"
            android:textStyle="bold"
            android:gravity="center"/>

        <!-- 与左侧图标等宽的占位，保证标题严格居中 -->
        <View
            android:layout_width="32dp"
            android:layout_height="32dp" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/popup_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/container_fonts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp" />

    </ScrollView>

</LinearLayout>
