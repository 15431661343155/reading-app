<?xml version="1.0" encoding="utf-8"?>
<!--图书 Item 布局（iOS 白卡片 + 灰底 grouped 风格）-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:duplicateParentState="true"
        android:padding="14dp"
        android:background="@drawable/bg_ios_card"
        android:foreground="@drawable/fg_card_ripple"
        android:gravity="center_vertical">

        <!-- 书籍封面 -->
        <ImageView
            android:id="@+id/iv_book_cover"
            android:layout_width="84dp"
            android:layout_height="114dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:background="@drawable/bg_cover_rounded"
            android:clipToOutline="true" />

        <!-- 书名 + 作者 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tv_book_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?attr/appTextPrimary"
                android:text="书名"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="?attr/appTextSecondary"
                android:layout_marginTop="6dp"
                android:text="作者" />

            <TextView
                android:id="@+id/tv_intro"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?attr/appTextSecondary"
                android:layout_marginTop="6dp"
                android:text="简介"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
