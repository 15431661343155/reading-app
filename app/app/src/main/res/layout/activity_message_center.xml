<?xml version="1.0" encoding="utf-8"?>
<!--消息中心页布局 - TabLayout + ViewPager2 分类导航-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <!-- 标题栏 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_back"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/appPageBg"
        app:navigationIcon="@drawable/ic_back_black"
        app:title="@string/message_center"
        app:titleCentered="true"
        app:titleTextColor="?attr/appTextPrimary">

        <!-- 全部已读按钮 -->
        <TextView
            android:id="@+id/tv_mark_all_read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:text="@string/message_mark_all_read"
            android:textColor="?attr/appTextPrimary"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- 滑动导航标签栏 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/appPageBg"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="?attr/appTextPrimary"
        app:tabIndicatorHeight="2dp"
        app:tabSelectedTextColor="?attr/appTextPrimary"
        app:tabTextColor="?attr/appTextPrimary"
        app:tabTextAppearance="@style/TextAppearance.MessageTab"
        app:tabRippleColor="#33FFFFFF" />

    <!-- 页面容器 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
