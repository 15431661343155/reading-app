<?xml version="1.0" encoding="utf-8"?>
<!-- 书城模式选择弹窗：本站藏书 / 外站书城 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="16dp">

    <!-- 顶部：标题 + 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="切换书城"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/appTextPrimary"/>

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close_grey"
            android:contentDescription="@null"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- 选项 A：📚 本站藏书 -->
    <LinearLayout
        android:id="@+id/opt_local"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_option_card"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@color/tile_warm_tint"
                android:gravity="center"
                android:text="📚"
                android:textSize="20sp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="本站藏书"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/appTextPrimary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="服务器数据库内的书籍"
                    android:textSize="12sp"
                    android:textColor="?attr/appTextSecondary"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_radio_local"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_checkbox_unchecked"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 选项 B：🌐 外站书城 -->
    <LinearLayout
        android:id="@+id/opt_external"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_option_card"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@color/tile_cool_tint"
                android:gravity="center"
                android:text="🌐"
                android:textSize="20sp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="外站书城"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/appTextPrimary"/>

                <!-- 当前书源回显：未选时「尚未选择书源」，已选时「当前书源：xxx」+ type 标签，由代码赋值 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tv_source_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="尚未选择书源"
                        android:textSize="12sp"
                        android:textColor="?attr/appTextSecondary"/>

                    <TextView
                        android:id="@+id/tv_source_state_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_source_tag"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1dp"
                        android:textSize="10sp"
                        android:textColor="?attr/appTextTertiary"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- 「选择书源」按钮：放到原说明位置，点击单独打开书源选择弹窗 -->
                <TextView
                    android:id="@+id/tv_select_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择书源 →"
                    android:textSize="12sp"
                    android:textColor="?attr/appAccent"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="2dp"
                    android:paddingVertical="2dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_radio_external"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_checkbox_unchecked"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 内联警示条：默认隐藏，未选书源就点外站卡片时由代码显示（弹窗保持打开） -->
    <LinearLayout
        android:id="@+id/ll_source_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_danger_hint_strip"
        android:paddingHorizontal="11dp"
        android:paddingVertical="9dp"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:background="@drawable/bg_danger_dot"
            android:gravity="center"
            android:text="!"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/appOnAccent"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="请先选择一个外站书源"
            android:textSize="12sp"
            android:textColor="?attr/appTextPrimary"/>
    </LinearLayout>
</LinearLayout>