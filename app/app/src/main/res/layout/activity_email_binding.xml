<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F1F8">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_back"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FBFAFE"
        app:title="@string/email_binding"
        app:titleCentered="true"
        app:titleTextColor="@color/ios_text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <!-- 当前绑定邮箱 -->
            <LinearLayout
                android:id="@+id/layout_current_email"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_cp_input"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前邮箱"
                    android:textSize="15sp"
                    android:textColor="#8E8AA0" />

                <TextView
                    android:id="@+id/tv_current_email"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:textAlignment="textEnd"
                    android:textColor="#1D1D1F"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="30dp"
                android:text="输入新邮箱"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1D1D1F" />

            <!-- 新邮箱 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_cp_input"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="11dp"
                    android:src="@drawable/ic_email"
                    app:tint="#8E8AA0" />

                <EditText
                    android:id="@+id/et_email"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="请输入邮箱"
                    android:inputType="textEmailAddress"
                    android:textSize="15sp"
                    android:textColor="#1D1D1F"
                    android:textColorHint="#B9B4C9" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_send_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cp_code_pill"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="获取验证码"
                    android:textColor="#6C5CE7"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 验证码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_cp_input"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="11dp"
                    android:src="@drawable/ic_security"
                    app:tint="#8E8AA0" />

                <EditText
                    android:id="@+id/et_code"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="请输入验证码"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textSize="15sp"
                    android:textColor="#1D1D1F"
                    android:textColorHint="#B9B4C9" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:text="验证码发送至新邮箱，60 秒后可重新获取"
                android:textSize="12sp"
                android:textColor="#A29DB8" />

            <com.example.myapplication.widget.MorphSubmitButton
                android:id="@+id/btn_bind"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
