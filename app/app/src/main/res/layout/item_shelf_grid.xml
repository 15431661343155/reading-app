<?xml version="1.0" encoding="utf-8"?>
<!--书架宫格单项（iOS 白卡片 + 灰底 grouped 风格）-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp"
    android:clickable="true"
    android:focusable="true">

    <!-- 白卡片容器（波纹挂卡片节点 + duplicateParentState 跟随根按压态，收敛在卡面内） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:duplicateParentState="true"
        android:background="@drawable/bg_ios_card"
        android:foreground="@drawable/fg_card_ripple">

        <!-- 封面容器 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp">

            <ImageView
                android:id="@+id/iv_book_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/default_book_cover"
                android:background="@drawable/bg_cover_rounded"
            android:clipToOutline="true" />

            <!-- 无封面时显示书名（iOS 半透明遮罩） -->
            <TextView
                android:id="@+id/tv_cover_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="书名"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:padding="8dp"
                android:background="#CC1D1D1F"
                android:visibility="gone" />

            <!-- 宫格模式编辑时的复选框 -->
            <ImageView
                android:id="@+id/iv_checkbox"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:src="@drawable/ic_checkbox_unchecked"
                android:visibility="gone"
                android:contentDescription="选择" />
        </FrameLayout>

        <!-- 书名 -->
        <TextView
            android:id="@+id/tv_book_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:text="书名"
            android:textColor="?attr/appTextPrimary"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center" />

        <!-- 阅读进度 -->
        <TextView
            android:id="@+id/tv_read_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="?attr/appTextSecondary"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:layout_gravity="center"
            android:text="未读" />
    </LinearLayout>
</LinearLayout>
