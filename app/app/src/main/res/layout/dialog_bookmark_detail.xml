<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ios_bg"
    android:padding="20dp">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="书签详情"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/ios_text_primary"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- 章节 -->
    <TextView
        android:id="@+id/tv_detail_chapter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="章节"
        android:textSize="15sp"
        android:textColor="@color/ios_text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- 预览文本 -->
    <TextView
        android:id="@+id/tv_detail_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="预览"
        android:textSize="13sp"
        android:textColor="@color/ios_text_secondary"
        android:maxLines="4"
        android:ellipsize="end"
        android:layout_marginBottom="4dp" />

    <!-- 时间 -->
    <TextView
        android:id="@+id/tv_detail_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="时间"
        android:textSize="12sp"
        android:textColor="@color/ios_text_secondary"
        android:layout_marginBottom="12dp" />

    <!-- 备注 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="备注"
        android:textSize="13sp"
        android:textColor="@color/ios_text_secondary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/et_note"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:hint="添加备注..."
        android:gravity="top"
        android:background="@color/ios_bg_grouped"
        android:padding="8dp"
        android:textSize="13sp" />

    <!-- 底部按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tv_delete_bookmark"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="删除"
            android:textSize="14sp"
            android:textColor="#FF4444"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="取消"
            android:textSize="14sp"
            android:textColor="@color/ios_text_secondary"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tv_confirm"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="确认"
            android:textSize="14sp"
            android:textColor="@color/ios_blue"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>
</LinearLayout>