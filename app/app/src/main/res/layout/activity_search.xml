<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索页布局（iOS 浅色磨砂玻璃风） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ios_bg_grouped">

    <!-- 顶部导航栏 + 搜索框 -->
    <LinearLayout
        android:id="@+id/layout_search_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/ios_bg_grouped">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- 返回按钮 -->
            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back_black"
                app:tint="@color/ios_blue"
                android:contentDescription="@null"
                android:padding="4dp"/>

            <!-- 搜索框 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_search_radius"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/ios_text_tertiary"
                    android:contentDescription="@null"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/et_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:hint="搜索书籍、作者、分类"
                    android:textColorHint="@color/ios_text_tertiary"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:imeOptions="actionSearch"
                    android:textColor="@color/ios_text_primary"
                    android:textSize="15sp"/>

                <ImageView
                    android:id="@+id/iv_clear_input"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_close_grey"
                    app:tint="@color/ios_text_tertiary"
                    android:contentDescription="@null"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- 搜索按钮 -->
            <TextView
                android:id="@+id/tv_search_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="搜索"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/ios_blue"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 分割线（iOS 0.5dp 规范） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/ios_separator"/>

    <!-- 内容区域（ViewFlipper：历史/结果） -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 搜索历史视图（默认显示） -->
            <ScrollView
                android:id="@+id/layout_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 🔍 搜索历史标题 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_history"
                            app:tint="@color/ios_text_secondary"
                            android:contentDescription="@null"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="搜索历史"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/ios_text_primary"/>

                        <ImageView
                            android:id="@+id/iv_clear_history"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_more_vert_black"
                            app:tint="@color/ios_text_secondary"
                            android:contentDescription="@null"
                            android:alpha="0.6"/>
                    </LinearLayout>

                    <!-- 历史关键词容器（动态添加，横向滚动） -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="28dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layout_history_tags"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"/>
                    </HorizontalScrollView>

                    <!-- 🔥 热门搜索标题 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@color/ios_system_orange"
                            android:gravity="center"
                            android:text="🔥"
                            android:textSize="12sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="热门搜索"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/ios_text_primary"/>
                    </LinearLayout>

                    <!-- 热门关键词容器（动态添加，横向滚动） -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layout_hot_tags"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"/>
                    </HorizontalScrollView>
                </LinearLayout>
            </ScrollView>

            <!-- 搜索结果视图（初始隐藏） -->
            <LinearLayout
                android:id="@+id/layout_results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 结果 Tab：全部/小说/文学/外站 -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_result_filter"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@color/ios_bg_grouped"
                    app:tabMode="fixed"
                    app:tabGravity="fill"
                    app:tabIndicatorColor="@color/ios_blue"
                    app:tabIndicatorHeight="2dp"
                    app:tabTextColor="@color/ios_text_secondary"
                    app:tabSelectedTextColor="@color/ios_blue"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_search_result"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
