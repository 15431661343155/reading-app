<?xml version="1.0" encoding="utf-8"?>
<!-- 阅读页面 - iOS 浅色磨砂玻璃风 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="?attr/appSurface">

    <!-- 阅读内容区域（嵌套 FrameLayout 防止导航栏显隐导致 WebView 高度变化） -->
    <!-- ✅ 不再放置占位 WebView：改由 ReadActivity 把复用池里的 WebView 动态插入，避免每次开书都 inflate 一个 WebView -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 左右点击翻页区域 -->
        <View
            android:id="@+id/view_left_tap"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="上一页" />

        <View
            android:id="@+id/view_right_tap"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="下一页"/>

        <!-- 章节加载中：与全站共用的加载动画（奔跑 GIF +「加载中」+ 三个点）。
             透明底 → 显示阅读页自己的背景/纹理，日夜与各种底色都不用额外适配；
             本控件不可点击 → 触摸照旧穿透到下面的左右翻页热区。 -->
        <com.example.myapplication.widget.LoadingView
            android:id="@+id/loading_chapter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:lvGifSize="140dp" />

        <!-- 章节加载失败覆盖层（本站书）：透明底 → 显示阅读页自己的背景/纹理，日夜与各种底色都不用额外适配。
             内容块整体略高于几何中心（paddingBottom 抬升），与「加载失败」效果图一致。
             容器不拦截点击 → 触摸照旧穿透到下面的左右翻页热区；「再试一次」按钮自身可点击。 -->
        <LinearLayout
            android:id="@+id/layout_load_fail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="150dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/img_load_fail_illust"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/img_load_fail"
                android:contentDescription="加载失败插画" />

            <TextView
                android:id="@+id/tv_load_fail_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="加载出错，请稍后再试"
                android:textSize="14sp"
                android:textColor="?attr/appTextSecondary" />

            <TextView
                android:id="@+id/btn_load_fail_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="30dp"
                android:paddingVertical="10dp"
                android:text="再试一次"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_load_fail_retry" />
        </LinearLayout>

    </FrameLayout>

    <!-- 上导航栏（iOS 毛玻璃观感：半透明白底 + elevation + 底部分隔线） -->
    <LinearLayout
        android:id="@+id/layout_top_nav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:background="?attr/appNavBg"
        android:elevation="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_back_black"
            app:tint="?attr/appAccent"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="返回" />

        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="书名"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?attr/appTextPrimary"
            android:gravity="center" />

        <ImageView
            android:id="@+id/iv_more"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_more_vert_black"
            app:tint="?attr/appTextPrimary"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="更多" />

    </LinearLayout>

    <!-- 下导航栏（iOS 毛玻璃观感）；clipChildren=false 允许液态滑块浮窗向上溢出导航栏绘制 -->
    <LinearLayout
        android:id="@+id/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:clipChildren="false"
        android:background="?attr/appNavBg"
        android:elevation="10dp"
        android:visibility="gone">

        <!-- 顶部分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="?attr/appSeparator"/>

        <!-- 第一行：上一章、进度条、下一章（滑轨与两侧按钮文字同线居中；
             clipToPadding/clipChildren=false 允许浮窗向上溢出本行绘制） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:paddingHorizontal="22dp"
            android:paddingVertical="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical">

            <!-- 上一章 -->
            <LinearLayout
                android:id="@+id/btn_prev_chapter"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_prev_chapter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上一章"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />
            </LinearLayout>

            <!-- 进度条区域：滑轨居中与按钮文字同线，章节名小字叠放在滑轨下缘空白处 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false">

                <com.example.myapplication.view.LiquidSlider
                    android:id="@+id/seekbar_progress"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_gravity="center_vertical" />

                <TextView
                    android:id="@+id/tv_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="1dp"
                    android:textSize="11sp"
                    android:textColor="?attr/appTextSecondary" />
            </FrameLayout>

            <!-- 下一章 -->
            <LinearLayout
                android:id="@+id/btn_next_chapter"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_next_chapter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下一章"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />
            </LinearLayout>

        </LinearLayout>

        <!-- 第二行：目录、夜间/日间、设置 -->
        <LinearLayout
            android:id="@+id/layout_bottom_row"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <LinearLayout
                android:id="@+id/btn_catalog"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_catalog_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_list_black"
                    app:tint="?attr/appTextPrimary"
                    android:contentDescription="目录" />

                <TextView
                    android:id="@+id/tv_catalog_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="目录"
                    android:textSize="12sp"
                    android:textColor="?attr/appTextSecondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_night_mode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_night_mode_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_night"
                    app:tint="?attr/appTextPrimary"
                    android:contentDescription="夜间模式" />

                <TextView
                    android:id="@+id/tv_night_mode_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="夜间"
                    android:textSize="12sp"
                    android:textColor="?attr/appTextSecondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_settings_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings_black"
                    app:tint="?attr/appTextPrimary"
                    android:contentDescription="设置" />

                <TextView
                    android:id="@+id/tv_settings_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:textSize="12sp"
                    android:textColor="?attr/appTextSecondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
