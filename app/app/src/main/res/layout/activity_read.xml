<?xml version="1.0" encoding="utf-8"?>
<!-- 阅读页面 - iOS 浅色磨砂玻璃风 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg">

    <!-- 阅读内容区域（嵌套 FrameLayout 防止导航栏显隐导致 WebView 高度变化） -->
    <FrameLayout
        android:id="@+id/webview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webview_reader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:background="@color/ios_bg" />

        <!-- 左右点击翻页区域 -->
        <View
            android:id="@+id/view_left_tap"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="上一页" />

        <View
            android:id="@+id/view_right_tap"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="下一页"/>

        <!-- 外站章节加载失败重试覆盖层（iOS 卡片风） -->
        <LinearLayout
            android:id="@+id/layout_external_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/bg_dialog_rounded"
            android:elevation="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_external_retry_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="章节加载失败"
                android:textSize="15sp"
                android:textColor="@color/ios_text_secondary"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

            <Button
                android:id="@+id/btn_external_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="重试"
                android:textColor="@color/white"
                android:backgroundTint="@color/ios_blue" />
        </LinearLayout>

    </FrameLayout>

    <!-- 上导航栏（iOS 毛玻璃观感：半透明白底 + elevation + 底部分隔线） -->
    <LinearLayout
        android:id="@+id/layout_top_nav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:background="@color/ios_tab_bar"
        android:elevation="10dp"
        android:visibility="gone"
        android:fitsSystemWindows="true">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_back_black"
            app:tint="@color/ios_blue"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="返回" />

        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="书名"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/ios_text_primary"
            android:gravity="center" />

        <ImageView
            android:id="@+id/iv_more"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_more_vert_black"
            app:tint="@color/ios_text_primary"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="更多" />

    </LinearLayout>

    <!-- 下导航栏（iOS 毛玻璃观感） -->
    <LinearLayout
        android:id="@+id/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/ios_tab_bar"
        android:elevation="10dp"
        android:visibility="gone">

        <!-- 顶部分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ios_separator"/>

        <!-- 第一行：上一章、进度条、下一章 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:gravity="center_vertical">

            <!-- 上一章 -->
            <LinearLayout
                android:id="@+id/btn_prev_chapter"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_prev_chapter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上一章"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />
            </LinearLayout>

            <!-- 进度条区域 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="6dp">

                <SeekBar
                    android:id="@+id/seekbar_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progressTint="@color/ios_blue"
                    android:thumbTint="@color/ios_blue" />

                <TextView
                    android:id="@+id/tv_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1/8章"
                    android:textSize="12sp"
                    android:textColor="@color/ios_text_secondary" />
            </LinearLayout>

            <!-- 下一章 -->
            <LinearLayout
                android:id="@+id/btn_next_chapter"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_next_chapter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下一章"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />
            </LinearLayout>

        </LinearLayout>

        <!-- 第二行：目录、夜间/日间、设置 -->
        <LinearLayout
            android:id="@+id/layout_bottom_row"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <LinearLayout
                android:id="@+id/btn_catalog"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_catalog_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_list_black"
                    app:tint="@color/ios_text_primary"
                    android:contentDescription="目录" />

                <TextView
                    android:id="@+id/tv_catalog_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="目录"
                    android:textSize="12sp"
                    android:textColor="@color/ios_text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_night_mode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_night_mode_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_night"
                    app:tint="@color/ios_text_primary"
                    android:contentDescription="夜间模式" />

                <TextView
                    android:id="@+id/tv_night_mode_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="夜间"
                    android:textSize="12sp"
                    android:textColor="@color/ios_text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_settings_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings_black"
                    app:tint="@color/ios_text_primary"
                    android:contentDescription="设置" />

                <TextView
                    android:id="@+id/tv_settings_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:textSize="12sp"
                    android:textColor="@color/ios_text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
