<?xml version="1.0" encoding="utf-8"?>
<!--协议 / 隐私政策 内嵌网页容器-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appPageBg"
    android:orientation="vertical">

    <!-- app_header：见 BaseActivity#onContentChanged，头部色带延伸到状态栏底下 -->
    <FrameLayout
        android:id="@+id/app_header"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/appPageBg">

        <ImageView
            android:id="@+id/iv_doc_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="10dp"
            android:src="@drawable/ic_login_back" />

        <TextView
            android:id="@+id/tv_doc_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="?attr/appTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/appSeparator" />

    <WebView
        android:id="@+id/web_doc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
