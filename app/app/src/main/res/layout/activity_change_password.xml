<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cp_page_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_back"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/cp_surface"
        app:title="修改密码"
        app:titleCentered="true"
        app:titleTextColor="@color/ios_text_primary" />

    <!-- 分段选择器：密码验证 / 邮箱验证（滑动指示器） -->
    <FrameLayout
        android:id="@+id/seg_track"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_cp_seg_track">

        <View
            android:id="@+id/seg_thumb"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_gravity="start"
            android:background="@drawable/bg_cp_seg_sel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <TextView
                android:id="@+id/tv_password_verify"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="密码验证"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/login_accent" />

            <TextView
                android:id="@+id/tv_email_verify"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="邮箱验证"
                android:textSize="15sp"
                android:textColor="@color/ios_text_secondary" />
        </LinearLayout>
    </FrameLayout>

    <!-- 内容区：两面板叠放，用于交叉淡化切换 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/layout_password_verify"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!-- 密码验证区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <!-- 当前密码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_cp_input"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="11dp"
                    android:src="@drawable/ic_password"
                    app:tint="@color/ios_text_secondary" />

                <EditText
                    android:id="@+id/et_old_password"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="请输入当前密码"
                    android:inputType="textPassword"
                    android:textSize="15sp"
                    android:textColor="@color/ios_text_primary"
                    android:textColorHint="@color/ios_text_tertiary" />

                <ImageView
                    android:id="@+id/iv_old_eye"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_login_eye_off"
                    app:tint="@color/ios_text_secondary" />
            </LinearLayout>

            <!-- 新密码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_cp_input"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="11dp"
                    android:src="@drawable/ic_password"
                    app:tint="@color/ios_text_secondary" />

                <EditText
                    android:id="@+id/et_new_password"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="请输入新密码"
                    android:inputType="textPassword"
                    android:textSize="15sp"
                    android:textColor="@color/ios_text_primary"
                    android:textColorHint="@color/ios_text_tertiary" />

                <ImageView
                    android:id="@+id/iv_new_eye"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_login_eye_off"
                    app:tint="@color/ios_text_secondary" />
            </LinearLayout>

            <!-- 确认新密码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_cp_input"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="11dp"
                    android:src="@drawable/ic_password"
                    app:tint="@color/ios_text_secondary" />

                <EditText
                    android:id="@+id/et_confirm_password"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="请确认新密码"
                    android:inputType="textPassword"
                    android:textSize="15sp"
                    android:textColor="@color/ios_text_primary"
                    android:textColorHint="@color/ios_text_tertiary" />

                <ImageView
                    android:id="@+id/iv_confirm_eye"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_login_eye_off"
                    app:tint="@color/ios_text_secondary" />
            </LinearLayout>

            <!-- 强度条 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/strength_bar"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cp_strength"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/strength_seg1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/cp_divider" />

                    <View
                        android:id="@+id/strength_seg2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/cp_divider" />

                    <View
                        android:id="@+id/strength_seg3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/cp_divider" />
                </LinearLayout>

                <TextView
                    android:id="@+id/strength_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="强度：弱"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/ios_text_primary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp"
                android:text="密码需为 8~64 位，且同时包含字母和数字"
                android:textSize="12sp"
                android:textColor="@color/ios_text_secondary" />

            <com.example.myapplication.widget.MorphSubmitButton
                android:id="@+id/btn_password_change"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp" />
        </LinearLayout>
    </ScrollView>

    <!-- 邮箱验证区域 -->
    <ScrollView
        android:id="@+id/layout_email_verify"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingTop="18dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tv_bound_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="16dp"
                android:text="您的邮箱："
                android:textSize="14sp"
                android:textColor="@color/ios_text_secondary" />

            <!-- 验证码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_cp_input"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="11dp"
                    android:src="@drawable/ic_security"
                    app:tint="@color/ios_text_secondary" />

                <EditText
                    android:id="@+id/et_email_code"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="请输入验证码"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textSize="15sp"
                    android:textColor="@color/ios_text_primary"
                    android:textColorHint="@color/ios_text_tertiary" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/cp_field_stroke" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_send_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cp_code_pill"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="发送验证码"
                    android:textColor="@color/login_accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 新密码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_cp_input"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="11dp"
                    android:src="@drawable/ic_password"
                    app:tint="@color/ios_text_secondary" />

                <EditText
                    android:id="@+id/et_email_new_password"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="请输入新密码"
                    android:inputType="textPassword"
                    android:textSize="15sp"
                    android:textColor="@color/ios_text_primary"
                    android:textColorHint="@color/ios_text_tertiary" />

                <ImageView
                    android:id="@+id/iv_email_new_eye"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_login_eye_off"
                    app:tint="@color/ios_text_secondary" />
            </LinearLayout>

            <!-- 确认新密码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_cp_input"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="11dp"
                    android:src="@drawable/ic_password"
                    app:tint="@color/ios_text_secondary" />

                <EditText
                    android:id="@+id/et_email_confirm_password"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="请确认新密码"
                    android:inputType="textPassword"
                    android:textSize="15sp"
                    android:textColor="@color/ios_text_primary"
                    android:textColorHint="@color/ios_text_tertiary" />

                <ImageView
                    android:id="@+id/iv_email_confirm_eye"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_login_eye_off"
                    app:tint="@color/ios_text_secondary" />
            </LinearLayout>

            <!-- 强度条 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/strength_bar_email"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cp_strength"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/strength_seg1_email"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/cp_divider" />

                    <View
                        android:id="@+id/strength_seg2_email"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/cp_divider" />

                    <View
                        android:id="@+id/strength_seg3_email"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/cp_divider" />
                </LinearLayout>

                <TextView
                    android:id="@+id/strength_label_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="强度：弱"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/ios_text_primary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp"
                android:text="密码需为 8~64 位，且同时包含字母和数字"
                android:textSize="12sp"
                android:textColor="@color/ios_text_secondary" />

            <com.example.myapplication.widget.MorphSubmitButton
                android:id="@+id/btn_email_change"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp" />
        </LinearLayout>
    </ScrollView>

    </FrameLayout>

</LinearLayout>
