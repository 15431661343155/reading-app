<?xml version="1.0" encoding="utf-8"?>
<!--
  阅读器「目录 / 书签」底部抽屉。
  根节点由 ReadTocPopupController 放进一个全屏 PopupWindow 的 FrameLayout 里，
  以 layout_gravity=bottom 贴底、并在下方让出阅读器底栏的高度，所以这里的
  match_parent 只是兜底，真实尺寸由控制器给的 LayoutParams 决定。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toc_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top_rounded"
    android:clipToOutline="true">

    <!-- 可拖拽区：指示条 + 书籍信息头，按住下拉超过阈值即收起抽屉 -->
    <LinearLayout
        android:id="@+id/toc_drag_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_toc_handle" />

        <!-- 书籍信息头：封面 / 书名 / 作者（目录与书签两页共用） -->
        <LinearLayout
            android:id="@+id/layout_popup_book_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/iv_popup_book_cover"
                android:layout_width="52dp"
                android:layout_height="70dp"
                android:scaleType="centerCrop"
                android:src="@drawable/default_book_cover"
                android:background="@drawable/bg_cover_rounded"
                android:clipToOutline="true"
                android:contentDescription="书籍封面" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_popup_book_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="书名"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/appTextPrimary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_popup_book_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="作者"
                    android:textSize="13sp"
                    android:textColor="?attr/appTextPrimary"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 目录 / 书签分段控件：轨道与选中胶囊由 ReadThemeController.themeSegTabs 现画 -->
    <LinearLayout
        android:id="@+id/seg_toc_tabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:padding="3dp"
        android:background="@drawable/bg_toc_seg_track">

        <TextView
            android:id="@+id/seg_tab_toc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="目录"
            android:textSize="14sp"
            android:textColor="?attr/appTextPrimary"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/seg_tab_bookmark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="书签"
            android:textSize="14sp"
            android:textColor="?attr/appTextPrimary"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ViewPager2 - 目录 / 书签内容区 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_popup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
