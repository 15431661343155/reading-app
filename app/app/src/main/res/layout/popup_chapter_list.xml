<?xml version="1.0" encoding="utf-8"?>
<!--章节目录弹窗布局-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ios_bg">

    <!-- ViewPager2 - 内容区域 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_popup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- TabLayout - 目录/书签切换 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_popup"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/ios_bg_grouped"
        app:tabIndicatorColor="@color/ios_blue"
        app:tabIndicatorHeight="2dp"
        app:tabSelectedTextColor="@color/ios_blue"
        app:tabTextColor="@color/ios_text_secondary"
        app:tabMode="fixed"
        app:tabGravity="fill" />

</LinearLayout>