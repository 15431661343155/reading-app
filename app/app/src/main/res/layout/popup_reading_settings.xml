<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top_rounded"
    android:clipToOutline="true"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- ========== 亮度调节 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="亮度"
            android:textSize="12sp"
            android:textColor="?attr/appTextPrimary" />

        <SeekBar
            android:id="@+id/seekbar_brightness"
            android:layout_width="200dp"
            android:layout_height="36dp"
            android:layout_weight="0"
            android:max="255"
            android:progress="128"
            android:progressDrawable="@drawable/bg_seekbar_brightness"
            android:thumbTint="?attr/appAccent" />

        <TextView
            android:id="@+id/tv_brightness_value"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="50%"
            android:textSize="12sp"
            android:textColor="@color/black" />

        <ImageView
            android:id="@+id/iv_follow_system"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_brightness_auto"
            app:tint="#000000"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="跟随系统亮度" />

    </LinearLayout>

    <!-- ========== 字号调节 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="字号"
            android:textSize="12sp"
            android:textColor="?attr/appTextPrimary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_capsule_gray"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/tv_font_minus"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:text="A-"
                android:textSize="12sp"
                android:textColor="?attr/appTextPrimary"
                android:gravity="center"
                android:background="@drawable/bg_capsule_white"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tv_font_size_display"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:text="18"
                android:textSize="12sp"
                android:textColor="?attr/appTextPrimary"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_font_plus"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:text="A+"
                android:textSize="12sp"
                android:textColor="?attr/appTextPrimary"
                android:gravity="center"
                android:background="@drawable/bg_capsule_white"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_switch_font"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="切换字体 >"
            android:textSize="12sp"
            android:textColor="?attr/appTextPrimary"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_capsule_gray" />

    </LinearLayout>

    <!-- ========== 背景选择 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="背景"
            android:textSize="12sp"
            android:textColor="?attr/appTextPrimary" />

        <!-- 羊皮纸(0) -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp">
            <View
                android:id="@+id/bg_color_2"
                android:layout_width="42dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_color_rect"/>

            <View
                android:id="@+id/bg_color_ring_2"
                android:layout_width="42dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_ring"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 护眼绿(1) -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp">
            <View
                android:id="@+id/bg_color_1"
                android:layout_width="42dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_color_rect"/>
            <View
                android:id="@+id/bg_color_ring_1"
                android:layout_width="42dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_ring"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 白色(3) -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp">

            <View
                android:id="@+id/bg_color_0"
                android:layout_width="42dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_color_rect" />

            <View
                android:id="@+id/bg_color_ring_0"
                android:layout_width="42dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_ring"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 夜间(3) -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="36dp">
            <View
                android:id="@+id/bg_color_3"
                android:layout_width="42dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_color_rect"/>
            <View
                android:id="@+id/bg_color_ring_3"
                android:layout_width="42dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_ring"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_bg_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="更多 >"
            android:textSize="12sp"
            android:textColor="?attr/appTextPrimary"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_capsule_gray" />

    </LinearLayout>

    <!-- ========== 翻页动画 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="翻页"
            android:textSize="12sp"
            android:textColor="?attr/appTextPrimary" />

        <!-- 与间距抽屉同款分段导航：轨道 + 滑动指示器（宽度/位置由代码计算） -->
        <FrameLayout
            android:id="@+id/seg_track_page"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_reader_seg_track">

            <View
                android:id="@+id/seg_thumb_page"
                android:layout_width="60dp"
                android:layout_height="36dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_shelf_seg_thumb" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tv_page_cover"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="覆盖"
                    android:textSize="12sp"
                    android:textColor="?attr/appTextPrimary"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tv_page_simulation"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="仿真"
                    android:textSize="12sp"
                    android:textColor="?attr/appTextPrimary"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tv_page_translate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="平移"
                    android:textSize="12sp"
                    android:textColor="?attr/appTextPrimary"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tv_page_updown"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="上下"
                    android:textSize="12sp"
                    android:textColor="?attr/appTextPrimary"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tv_page_fade"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="淡入"
                    android:textSize="12sp"
                    android:textColor="?attr/appTextPrimary"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- ========== 间距（行段间距 / 页面边距） ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="间距"
            android:textSize="12sp"
            android:textColor="?attr/appTextPrimary" />

        <LinearLayout
            android:id="@+id/btn_line_spacing"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_capsule_gray"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="行段间距"
                android:textSize="12sp"
                android:textColor="?attr/appTextPrimary" />

            <TextView
                android:id="@+id/tv_line_spacing_cur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="适中"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/appTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="›"
                android:textSize="11sp"
                android:textColor="?attr/appTextPrimary" />
        </LinearLayout>

        <View
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/btn_page_margin"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_capsule_gray"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="页面边距"
                android:textSize="12sp"
                android:textColor="?attr/appTextPrimary" />

            <TextView
                android:id="@+id/tv_margin_cur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="适中"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/appTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="›"
                android:textSize="11sp"
                android:textColor="?attr/appTextPrimary" />
        </LinearLayout>

    </LinearLayout>

    <!-- ========== 自动翻页 ========== -->
    <LinearLayout
        android:id="@+id/layout_auto_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="4dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/layout_auto_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp"
            android:paddingEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_auto_page_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动翻页"
                android:textColor="?attr/appTextPrimary"
                android:textSize="12sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_auto_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_more_settings"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="更多阅读设置 >"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:paddingStart="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>


</LinearLayout>