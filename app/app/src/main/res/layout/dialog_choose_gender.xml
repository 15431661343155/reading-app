<?xml version="1.0" encoding="utf-8"?>
<!--
  选择性别弹窗（国风版 · 与 dialog_edit_nickname.xml 同构）
  · 入口：activity/ProfileActivity.showGenderDialog()
  · 系统单选圈换成「隐 / 乾 / 坤」小印章 + 卡片行选中态；选项需点「确定」才生效，
    与用户名弹窗保持一致的「取消 / 确定」结构。
  · 卡片宽度 280dp 与窗口 312dp 的原因同 dialog_edit_nickname.xml（见该文件头部注释）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp">

    <FrameLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_login_prompt_card"
        android:elevation="14dp"
        android:outlineAmbientShadowColor="#402E1E0A"
        android:outlineSpotShadowColor="#402E1E0A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="28dp"
            android:paddingEnd="22dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.25"
                android:text="选择性别"
                android:textColor="@color/gf_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="130dp"
                android:layout_height="10dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_login_prompt_divider" />

            <!-- 选项行：整行可点（52dp 高，满足触控热区） -->
            <LinearLayout
                android:id="@+id/gender_opt_0"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_gf_option"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/gender_stamp_0"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_gf_stamp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="隐"
                    android:textColor="@color/gf_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gender_label_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:text="保密"
                    android:textColor="@color/gf_ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/gender_flag_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:letterSpacing="0.08"
                    android:text="当前"
                    android:textColor="@color/gf_teal"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/gender_radio_0"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_gf_radio_off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gender_opt_1"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_gf_option"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/gender_stamp_1"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_gf_stamp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="乾"
                    android:textColor="@color/gf_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gender_label_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:text="男"
                    android:textColor="@color/gf_ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/gender_flag_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:letterSpacing="0.08"
                    android:text="当前"
                    android:textColor="@color/gf_teal"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/gender_radio_1"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_gf_radio_off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gender_opt_2"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_gf_option"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/gender_stamp_2"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_gf_stamp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="坤"
                    android:textColor="@color/gf_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gender_label_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.08"
                    android:text="女"
                    android:textColor="@color/gf_ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/gender_flag_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:letterSpacing="0.08"
                    android:text="当前"
                    android:textColor="@color/gf_teal"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/gender_radio_2"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_gf_radio_off" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_gender_cancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gf_btn_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="serif"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:text="取消"
                    android:textColor="@color/gf_ink_2"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btn_gender_ok"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gf_btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="serif"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:text="确定"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 卡片左上角云纹 -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="16dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_login_prompt_cloud" />

        <!-- 卡片右上角云纹 -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_login_prompt_cloud" />
    </FrameLayout>
</FrameLayout>
