<!--主页布局（iOS 浅色磨砂玻璃风）-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appPageBg">

    <!-- 内容区域：全屏铺满。系统栏出血下根布局不再 fitsSystemWindows：
         顶部 inset 由各标签页自己决定落在哪一层（「我的」英雄区要铺到屏幕顶），
         底部 inset 由 MainActivity#onCreate 加到本容器与下方磨砂卡上。 -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 底部导航栏（实时磨砂玻璃：采样背后内容做模糊 + 半透明叠加 + 颗粒 + 高光）
         系统导航条的避让由根布局 paddingBottom 统一负责，卡片本身不动布局 -->
    <com.example.myapplication.widget.FrostedNavCardView
        android:id="@+id/nav_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="11dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeWidth="0.5dp"
        app:strokeColor="@color/nav_frost_stroke"
        app:frostBackdrop="@id/fragment_container"
        app:frostTint="@color/nav_frost_tint"
        app:frostBaseColor="@color/nav_frost_base"
        app:frostSheen="@color/nav_frost_sheen"
        app:frostBlurRadius="18dp"
        app:frostDownscale="6"
        app:frostNoiseAlpha="0"
        app:frostEnabled="true"
        app:frostCornerRadius="28dp">

        <!-- 四个 tab：书架 / 书城 / 分类 / 我的
             未选中只显示图标；选中显示图标+文字并垫主题色胶囊，切换时槽位互相让位 -->
        <com.example.myapplication.widget.YieldBottomNav
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:yieldMenu="@menu/menu_bottom_nav"
            app:yieldCornerRadius="28dp" />

    </com.example.myapplication.widget.FrostedNavCardView>

    <!-- ═══ 开屏浮层（单窗口开屏）：
         冷启动时盖住整个主页，展示 ≥2.5s 且书架数据就绪后淡出揭示书架。
         与 MainActivity 窗口背景同图，替代原独立 SplashActivity，
         彻底消除系统转场/starting window 造成的白屏与「第二张开屏图」。
         默认 GONE：仅冷启动（savedInstanceState==null）由代码置 VISIBLE。
         系统栏出血后它连状态栏后面一起盖住，开屏期间不再露出窗口色带；
         插画只有日间那一版奶油底，所以浮层期间图标一律压成深色，见 MainActivity。 ═══ -->
    <FrameLayout
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/splash_window_bg"
            android:importantForAccessibility="no" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
