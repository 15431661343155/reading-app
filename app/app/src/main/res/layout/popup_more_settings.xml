<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top_rounded"
    android:clipToOutline="true"
    android:paddingBottom="12dp">

    <!-- 标题栏 -->
    <RelativeLayout
        android:id="@+id/popup_title_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/ios_bg_grouped">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_centerInParent="true"
            android:text="更多设置"
            android:textSize="16sp"
            android:textColor="@color/ios_text_primary"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/tv_more_settings_done"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/shouqi"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="关闭" />
    </RelativeLayout>

    <!-- 内容区：固定半屏，超出滚动 -->
    <ScrollView
        android:id="@+id/popup_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 页眉页脚开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="显示页眉页脚"
                    android:textSize="14sp"
                    android:textColor="@color/ios_text_primary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_header_footer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/ios_separator" />

            <!-- 页眉页脚字号调节 -->
            <LinearLayout
                android:id="@+id/layout_header_footer_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="页眉页脚字号"
                    android:textSize="14sp"
                    android:textColor="@color/ios_text_primary" />

                <TextView
                    android:id="@+id/tv_header_footer_minus"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="−"
                    android:textSize="20sp"
                    android:textColor="@color/ios_blue"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tv_header_footer_size_display"
                    android:layout_width="52dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="14"
                    android:textSize="18sp"
                    android:textColor="@color/ios_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_header_footer_plus"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="+"
                    android:textSize="20sp"
                    android:textColor="@color/ios_blue"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- 提示文字 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="调整范围 8 - 24"
                android:textSize="11sp"
                android:textColor="@color/ios_text_secondary"
                android:paddingHorizontal="20dp" />

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/ios_separator" />

            <!-- 电量时间显示开关（次级设置，跟随页眉页脚开关） -->
            <LinearLayout
                android:id="@+id/layout_battery_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="页脚显示电量时间"
                    android:textSize="14sp"
                    android:textColor="@color/ios_text_primary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_battery_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/ios_separator" />

            <!-- 音量键翻页开关 -->
            <LinearLayout
                android:id="@+id/layout_volume_key_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="音量键翻页"
                    android:textSize="14sp"
                    android:textColor="@color/ios_text_primary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_volume_key_page"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 滑动翻页开关 -->
            <LinearLayout
                android:id="@+id/layout_swipe_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="滑动翻页"
                    android:textSize="14sp"
                    android:textColor="@color/ios_text_primary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_swipe_page"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/ios_separator" />

            <!-- 屏幕亮屏时间（阅读时） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="屏幕亮屏时间"
                    android:textSize="14sp"
                    android:textColor="@color/ios_text_primary" />

                <LinearLayout
                    android:id="@+id/layout_screen_timeout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_screen_system"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="跟随系统"
                        android:textSize="13sp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="5dp"
                        android:gravity="center"
                        android:background="@drawable/bg_capsule_gray"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_screen_1min"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1分钟"
                        android:textSize="13sp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="5dp"
                        android:gravity="center"
                        android:background="@drawable/bg_capsule_gray"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="6dp" />

                    <TextView
                        android:id="@+id/tv_screen_5min"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5分钟"
                        android:textSize="13sp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="5dp"
                        android:gravity="center"
                        android:background="@drawable/bg_capsule_gray"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="6dp" />

                    <TextView
                        android:id="@+id/tv_screen_always"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="常亮"
                        android:textSize="13sp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="5dp"
                        android:gravity="center"
                        android:background="@drawable/bg_capsule_gray"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 提示文字 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="阅读时保持亮屏；定时模式下无操作超时后正常熄屏"
                android:textSize="11sp"
                android:textColor="@color/ios_text_secondary"
                android:paddingHorizontal="20dp" />

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/ios_separator" />

            <!-- 自动翻页速度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="自动翻页速度"
                    android:textSize="14sp"
                    android:textColor="@color/ios_text_primary" />

                <LinearLayout
                    android:id="@+id/layout_auto_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_auto_slow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="慢"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:gravity="center"
                        android:background="@drawable/bg_capsule_gray"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tv_auto_normal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="中"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:gravity="center"
                        android:background="@drawable/bg_capsule_gray"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/tv_auto_fast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:gravity="center"
                        android:background="@drawable/bg_capsule_gray"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
