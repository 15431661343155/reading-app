<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ios_bg"
    android:paddingBottom="20dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/ios_bg_grouped">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="更多设置"
            android:textSize="18sp"
            android:textColor="@color/ios_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_more_settings_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="完成"
            android:textSize="16sp"
            android:textColor="@color/ios_blue"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 页眉页脚开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="显示页眉页脚"
            android:textSize="16sp"
            android:textColor="@color/ios_text_primary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_header_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ios_separator" />

    <!-- 页眉页脚字号调节 -->
    <LinearLayout
        android:id="@+id/layout_header_footer_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="页眉页脚字号"
            android:textSize="16sp"
            android:textColor="@color/ios_text_primary" />

        <TextView
            android:id="@+id/tv_header_footer_minus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="−"
            android:textSize="22sp"
            android:textColor="@color/ios_blue"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_header_footer_size_display"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="14"
            android:textSize="20sp"
            android:textColor="@color/ios_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_header_footer_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="+"
            android:textSize="22sp"
            android:textColor="@color/ios_blue"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ios_separator" />

    <!-- 电量时间显示开关（次级设置，跟随页眉页脚开关） -->
    <LinearLayout
        android:id="@+id/layout_battery_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="页脚显示电量时间"
            android:textSize="16sp"
            android:textColor="@color/ios_text_primary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_battery_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ios_separator" />

    <!-- 音量键翻页开关 -->
    <LinearLayout
        android:id="@+id/layout_volume_key_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="音量键翻页"
            android:textSize="16sp"
            android:textColor="@color/ios_text_primary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_volume_key_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 滑动翻页开关 -->
    <LinearLayout
        android:id="@+id/layout_swipe_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="滑动翻页"
            android:textSize="16sp"
            android:textColor="@color/ios_text_primary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_swipe_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ios_separator" />

    <!-- 提示文字 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="页眉页脚字号调整范围为 8 - 24"
        android:textSize="13sp"
        android:textColor="@color/ios_text_secondary"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp" />

</LinearLayout>