<?xml version="1.0" encoding="utf-8"?>
<!--目录 popup 布局（iOS 分组列表风）。
    右下角覆盖一个「定位当前章节」悬浮按钮：滑动目录后点它可回滚到当前章。-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 章节计数 + 正序/倒序切换（点右侧按钮切换顺序，标签同步变成当前顺序） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_chapter_count"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="共 0 章"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/appTextPrimary"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/btn_toc_sort"
                style="@style/TocSortButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:textColor="?attr/appTextPrimary"
                android:text="正序" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.4dp"
            android:alpha="0.6"
            android:background="?attr/appSeparator" />

        <!-- 列表 + 自绘的快速滑动把手。库自带滑块在 PopupChapterFragment 里已关掉
             （它没有替换滑块绘制的钩子），所以这里不再声明任何 fastScroll* 属性。 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.simplecityapps.recyclerview_fastscroll.views.FastScrollRecyclerView
                android:id="@+id/rv_fastscroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.example.myapplication.view.TocScrollThumbView
                android:id="@+id/toc_scroll_thumb"
                android:layout_width="24dp"
                android:layout_height="38dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- 定位当前章节：半透明圆盘 + 主文字色图标（颜色在 ReadActivity 主题染色里统一设置） -->
    <ImageView
        android:id="@+id/btn_toc_locate"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:padding="10dp"
        android:background="@drawable/bg_toc_locate_fab"
        android:src="@drawable/ic_toc_locate"
        android:contentDescription="定位当前章节"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>
