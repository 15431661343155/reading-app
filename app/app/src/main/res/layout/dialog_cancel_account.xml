<?xml version="1.0" encoding="utf-8"?>
<!--
  注销账号确认弹窗（国风探出版）
  · 入口唯一：ProfileActivity.showCancelAccountDialog()，替代旧系统 AlertDialog。
  · 结构与 dialog_login_prompt.xml 同构：根 FrameLayout 预留人物探出空间；
    卡片 marginTop 100dp + paddingTop 85dp 形成「人物约半身探出卡片上沿」。
  · 人物图 drawable-nodpi/cancel_account_char.png 为透明底 PNG（140dp 宽）。
  · 危险按钮用朱砂渐变（bg_cancel_account_btn_danger），与登录弹窗青绿主按钮区分，
    提示「确认注销」是不可逆操作；卡片/云纹/分隔线/波浪纹复用登录弹窗现有 drawable。
-->
<!--
  ⚠️ 与登录弹窗同坑：inflate(layout, null) 会丢根布局 layout_*，
  卡片宽度必须写死 280dp；窗口宽度由 ProfileActivity 显式 setLayout(312dp)。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp">

    <!-- 人物立绘：elevation 高于卡片才能压在卡片上沿之上（探出效果） -->
    <ImageView
        android:id="@+id/iv_cancel_account_char"
        android:layout_width="140dp"
        android:layout_height="176dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:elevation="20dp"
        android:outlineProvider="none"
        android:scaleType="fitCenter"
        android:src="@drawable/cancel_account_char" />

    <!-- 卡片：宽度必须写死 280dp -->
    <FrameLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="100dp"
        android:background="@drawable/bg_login_prompt_card"
        android:elevation="14dp"
        android:outlineAmbientShadowColor="#402E1E0A"
        android:outlineSpotShadowColor="#402E1E0A"
        tools:targetApi="28">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="85dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/tv_cancel_account_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.25"
                android:text="注销账号"
                android:textColor="?attr/appTextPrimary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="130dp"
                android:layout_height="10dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_login_prompt_divider" />

            <TextView
                android:id="@+id/tv_cancel_account_line1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="注销后，您的所有数据将被永久删除"
                android:textColor="?attr/appTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_cancel_account_line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="书架、阅读进度与个人资料均无法恢复"
                android:textColor="?attr/appTextSecondary"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="14dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/ic_login_prompt_wave" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="40dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_cancel_account_cancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_prompt_btn_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="serif"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="再想想"
                    android:textColor="?attr/appTextStrong"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btn_cancel_account_confirm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cancel_account_btn_danger"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="serif"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="确认注销"
                    android:textColor="?attr/appOnAccent"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 卡片左上角云纹 -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="16dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_login_prompt_cloud" />

        <!-- 卡片右上角云纹 -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_login_prompt_cloud" />
    </FrameLayout>
</FrameLayout>
