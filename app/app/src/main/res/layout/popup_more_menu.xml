<?xml version="1.0" encoding="utf-8"?>
<!--更多菜单弹窗布局-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_search_radius"
    android:elevation="8dp"
    android:padding="6dp">

    <TextView
        android:id="@+id/tv_menu_detail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="书籍详情"
        android:textSize="16sp"
        android:textColor="?attr/appTextPrimary"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="?attr/appSeparator" />

    <TextView
        android:id="@+id/tv_menu_bookmark"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="添加书签"
        android:textSize="16sp"
        android:textColor="?attr/appTextPrimary"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="?attr/appSeparator" />

    <TextView
        android:id="@+id/tv_menu_share"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="分享"
        android:textSize="16sp"
        android:textColor="?attr/appTextPrimary"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>