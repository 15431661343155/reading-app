<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground">

    <!-- 内容区：原 LinearLayout 整体内嵌，保持原有垂直布局不变 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_back"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/appSurface"
            app:navigationIcon="@drawable/ic_back_black"
            app:title="书源管理"
            app:titleCentered="true"
            app:titleTextColor="?attr/appTextPrimary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button
                android:id="@+id/btnImportUrl"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="🌐 网络导入"
                android:textSize="14sp"
                android:backgroundTint="#4CAF50"
                android:textColor="@color/white"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnAdd"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="手动添加"
                android:textSize="14sp"
                android:backgroundTint="?attr/appSurface"
                android:textColor="?attr/appAccent"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/appSeparator" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/sourceListLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 加载动画：首次拉取在线书源期间显示（列表空白期），与全站 LoadingView 风格统一 -->
    <com.example.myapplication.widget.LoadingView
        android:id="@+id/loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:lvGifSize="140dp" />

</FrameLayout>
