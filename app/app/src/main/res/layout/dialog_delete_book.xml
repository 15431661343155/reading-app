<?xml version="1.0" encoding="utf-8"?>
<!--
  删除书籍确认弹窗（国风探出版）
  · 入口唯一：BookShelfFragment.showDeleteConfirmDialog(...)，管理态点「删除」先过这道闸。
  · 与 dialog_login_prompt.xml 同构同尺寸：人物 140×146dp、卡片 marginTop 83dp + paddingTop 72dp
    （人物约四成探出卡片上沿）；卡片/云纹/分隔线/波浪纹全部复用登录弹窗现有 drawable。
  · 危险按钮沿用注销账号那枚朱砂（bg_cancel_account_btn_danger），删除同为不可逆操作。
  · 「清除书籍缓存」勾选行复用清缓存抽屉的圆形复选框（sel_cache_checkbox）；
    刻意用 ImageView + state_selected 而非 CheckBox，避开 Material 的 buttonTint 把勾吞掉。
  · ⚠️ 与登录弹窗同坑：inflate(layout, null) 会丢根布局 layout_*，卡片宽度必须写死 280dp，
    窗口宽度由调用方 window.setLayout(312dp) 显式指定（312 = 280 + 左右各 16dp 投影留白）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="16dp">

    <ImageView
        android:id="@+id/iv_delete_book_char"
        android:layout_width="140dp"
        android:layout_height="146dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:elevation="20dp"
        android:outlineProvider="none"
        android:scaleType="fitCenter"
        android:src="@drawable/login_prompt_char" />

    <FrameLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="83dp"
        android:background="@drawable/bg_login_prompt_card"
        android:elevation="14dp"
        android:outlineAmbientShadowColor="#402E1E0A"
        android:outlineSpotShadowColor="#402E1E0A"
        tools:targetApi="28">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="72dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.25"
                android:text="删除书籍"
                android:textColor="?attr/appTextPrimary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="130dp"
                android:layout_height="10dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_login_prompt_divider" />

            <TextView
                android:id="@+id/tv_delete_book_line1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:textColor="?attr/appTextSecondary"
                android:textSize="13sp"
                tools:text="确定要删除《宿命之环》吗？" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="阅读进度与书签将一并清除"
                android:textColor="?attr/appTextSecondary"
                android:textSize="13sp" />

            <!-- 勾选行：整行可点，扩大命中区 -->
            <LinearLayout
                android:id="@+id/row_delete_clear_cache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="17dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/iv_delete_clear_cache"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/sel_cache_checkbox" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="清除书籍缓存"
                        android:textColor="?attr/appTextStrong"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="已下载的章节、正文与封面一并释放"
                        android:textColor="?attr/appTextSecondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="14dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/ic_login_prompt_wave" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="40dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_delete_book_cancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_prompt_btn_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="serif"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="取消"
                    android:textColor="?attr/appTextStrong"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btn_delete_book_confirm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cancel_account_btn_danger"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="serif"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="确认删除"
                    android:textColor="?attr/appOnAccent"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 卡片左上角云纹 -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="16dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_login_prompt_cloud" />

        <!-- 卡片右上角云纹 -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_login_prompt_cloud" />
    </FrameLayout>
</FrameLayout>
