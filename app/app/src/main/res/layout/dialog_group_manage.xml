<?xml version="1.0" encoding="utf-8"?>
<!-- 书架分组管理弹窗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ios_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="分组管理"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/ios_text_primary"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- 默认分组（只读） -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="默认分组"
        android:textSize="13sp"
        android:textColor="@color/ios_text_secondary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_default_groups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="全部 / 本地 / 未分组 / 外站"
        android:textSize="14sp"
        android:textColor="@color/ios_text_secondary"
        android:layout_marginBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ios_separator"
        android:layout_marginBottom="12dp" />

    <!-- 自定义分组列表 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="自定义分组"
        android:textSize="13sp"
        android:textColor="@color/ios_text_secondary"
        android:layout_marginBottom="4dp" />

    <ListView
        android:id="@+id/lv_custom_groups"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="80dp"
        android:divider="@color/ios_separator"
        android:dividerHeight="1dp" />

    <!-- 添加分组 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/et_group_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="新分组名称"
            android:textSize="14sp"
            android:inputType="text"
            android:maxLength="12"
            android:background="@null"
            android:padding="8dp" />

        <Button
            android:id="@+id/btn_add_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/ios_blue"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="完成"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/ios_blue"
        android:layout_marginTop="12dp" />

</LinearLayout>
