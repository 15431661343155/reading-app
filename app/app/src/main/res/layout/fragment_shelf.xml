<?xml version="1.0" encoding="utf-8"?>
<!--书架页布局（iOS 浅色磨砂玻璃风：浅灰底 + 白卡片）-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appPageBg">

    <!-- 内容层 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部导航栏：磨砂玻璃 + 大标题 -->
        <LinearLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp"
            android:background="?attr/appPageBg">

            <!-- 大标题 -->
            <TextView
                android:id="@+id/tv_page_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="书架"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="?attr/appTextPrimary"
                android:fontFamily="sans-serif-medium" />

            <!-- 阅读时长（小文字，替代搜索图标） -->
            <TextView
                android:id="@+id/tv_read_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="阅读时长 0 分钟"
                android:textSize="13sp"
                android:textColor="?attr/appTextSecondary"
                android:layout_marginEnd="8dp" />

            <!-- 更多按钮（三个点） -->
            <ImageView
                android:id="@+id/iv_more"
                android:layout_width="32dp"
                android:layout_height="32dp"
                tools:ignore="TouchTargetSizeCheck"
                android:src="@drawable/ic_more_menu"
                app:tint="?attr/appTextPrimary"
                android:padding="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="更多" />
        </LinearLayout>

        <!-- 分组 Tab：外层挂轨道背景，内部 [指示器(底) → 文字(顶)]，保证 白块>轨道 且 文字>白块 -->
        <FrameLayout
            android:id="@+id/frame_group_tabs"
            android:layout_width="match_parent"
            android:layout_height="42dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="4dp"
                android:background="@drawable/bg_shelf_seg_track">

                <!-- 滑动指示器：先声明 = 在文字下层；四周 3dp 悬浮内嵌 -->
                <View
                    android:id="@+id/seg_thumb_shelf"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:layout_gravity="start|center_vertical"
                    android:visibility="invisible" />

                <!-- 等宽分段容器：所有分组 weight 均分，加组时自动压缩让位 -->
                <LinearLayout
                    android:id="@+id/layout_group_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingHorizontal="3dp" />
            </FrameLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="?attr/appPageBg" />

        <!-- 下拉刷新 + 书籍列表 -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/appPageBg"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <com.simplecityapps.recyclerview_fastscroll.views.FastScrollRecyclerView
                android:id="@+id/rv_shelf"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="0dp"
                android:visibility="gone"
                android:paddingBottom="72dp"
                android:clipToPadding="false"
                android:scrollbarStyle="outsideOverlay"
                app:fastScrollAutoHide="true"
                app:fastScrollAutoHideDelay="1000"
                app:fastScrollThumbColor="?attr/appAccent"
                app:fastScrollTrackColor="@android:color/transparent"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <!-- 空状态：人物插画 + 两行文案 + 「去书城逛逛」CTA -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="visible">

        <ImageView
            android:id="@+id/iv_empty_char"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/shelf_empty_char" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="书架空空如也"
            android:textSize="17sp"
            android:textColor="?attr/appTextSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="去书城逛逛吧"
            android:textSize="14sp"
            android:textColor="?attr/appTextTertiary" />

        <TextView
            android:id="@+id/btn_go_store"
            android:layout_width="124dp"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_shelf_empty_cta"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="去书城逛逛"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 加载动画：首屏向服务器请求书架期间显示（避免误闪「书架空空如也」） -->
    <com.example.myapplication.widget.LoadingView
        android:id="@+id/loading_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
