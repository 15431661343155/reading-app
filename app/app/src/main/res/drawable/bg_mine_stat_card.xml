<?xml version="1.0" encoding="utf-8"?>
<!-- 我的页：白色统计卡（14dp 圆角 + 4 层等距淡出柔影，骑跨hero与灰底交界）
     与全站卡片柔影风格统一；本体 inset(3/4/2/2) 由 fragment_mine 布局侧 margin 补偿 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 最外层：最淡、扩散最大 -->
    <item android:top="0dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#03000000" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#05000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#08000000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item android:top="2dp" android:bottom="3dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0B000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- 卡片本体 -->
    <item
        android:top="3dp"
        android:bottom="4dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/appCard" />
            <corners android:radius="14dp" />
            <stroke
                android:width="0.5dp"
                android:color="#0D101828" />
        </shape>
    </item>
</layer-list>
