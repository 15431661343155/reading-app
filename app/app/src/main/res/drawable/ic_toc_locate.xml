<!--目录浮窗「定位当前章节」图标：圆环 + 中心点 + 四向刻度（与参考设计一致）。
    颜色由 ImageView 的 tint 决定（ReadActivity 主题染色时按主文字色设置），此处仅提供形状。-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#1D1D1F">

    <!-- 圆环（描边，不填充） -->
    <path
        android:pathData="M12,5.6A6.4,6.4 0 1,0 12,18.4A6.4,6.4 0 1,0 12,5.6Z"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6" />

    <!-- 中心点 -->
    <path
        android:pathData="M12,10.1A1.9,1.9 0 1,0 12,13.9A1.9,1.9 0 1,0 12,10.1Z"
        android:fillColor="@android:color/white" />

    <!-- 四向刻度 -->
    <path
        android:pathData="M12,1.6L12,4.0"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M12,20.0L12,22.4"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M1.6,12L4.0,12"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M20.0,12L22.4,12"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />
</vector>
