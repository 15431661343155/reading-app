<?xml version="1.0" encoding="utf-8"?>
<!-- 选项卡片·警示态：与 bg_option_card 同构，只把本体描边换成危险色，
     用于「未选书源就点外站书城」时把待操作的卡片勾出来 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#03000000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#05000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#08000000" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="1dp"
        android:right="1dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#0B000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="2dp"
        android:right="2dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/appCard" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/appDangerStroke" />
        </shape>
    </item>
</layer-list>
