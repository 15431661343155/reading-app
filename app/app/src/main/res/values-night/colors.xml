<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== iOS 设计 Token 的夜间取值 =====
         与 values/colors.xml 同名，按 uiMode 自动覆盖：布局/样式/代码里引用 @color/ios_* 的地方
         都会随之反相，不需要再维护一套 *_dark 命名。
         取值尽量复用已有的深色基准，避免同一色值散落两处。 -->
    <color name="ios_blue">@color/ios_blue_dark</color>                 <!-- #0A84FF：深色底上的系统蓝更亮 -->
    <color name="ios_accent_stroke">#570A84FF</color>                   <!-- 主色 34% 描边，夜间跟 #0A84FF 提亮 -->
    <color name="ios_ornament_faint">#FF3A3A3C</color>                  <!-- 云纹 / 水波纹：浮在 #2C2C2E 卡片上 -->
    <color name="ios_danger_btn">#FFD04436</color>                      <!-- 危险按钮底：夜间压深一档保住白字对比 -->
    <color name="ios_danger_tint">#24D04436</color>                     <!-- 警示提示条薄底：黑底上比日间提一档才看得见 -->
    <color name="ios_danger_stroke">#5AD04436</color>                   <!-- 同上描边 -->
    <color name="ios_field_stroke">#FF4E4E52</color>                    <!-- 输入框描边 -->
    <color name="ios_bg">@color/ios_bg_grouped_dark</color>             <!-- #1C1C1E：抬起的面（标题栏/弹窗） -->
    <color name="ios_bg_grouped">@color/ios_bg_dark</color>              <!-- #000000：页面底色（iOS 分组背景） -->
    <color name="ios_bg_grouped_2">@color/ios_bg_grouped_dark</color>
    <color name="ios_card_bg">@color/ios_card_float_dark</color>         <!-- #2C2C2E：卡片浮在纯黑页底之上 -->
    <color name="ios_nav_bg">@color/ios_bg_grouped_dark</color>
    <color name="ios_tab_bar">@color/ios_tab_bar_dark</color>
    <color name="ios_text_primary">@color/ios_text_primary_dark</color>
    <color name="ios_text_secondary">@color/ios_text_secondary_dark</color>
    <color name="ios_text_tertiary">#FF636368</color>                    <!-- 占位/禁用：黑底上仍可辨，约 3.4:1 -->
    <color name="ios_separator">@color/ios_separator_dark</color>
    <color name="ios_separator_opaque">#FF545458</color>

    <!-- 开屏：宣纸插画为浅色，夜间窗口底改为深色，避免冷启动闪白 -->
    <color name="splash_bg">#FF1C1C1E</color>

    <color name="chip_bg">#FF3A3A3C</color>                <!-- 芯片浮在 #2C2C2E 卡片之上 -->
    <color name="seg_track_bg">#FF2C2C2E</color>
    <color name="seg_thumb_bg">#FF48484A</color>
    <color name="seg_thumb_shadow">#66000000</color>
    <color name="seg_text_selected">#FFFFFFFF</color>

    <!-- 修改密码 / 邮箱绑定页的 cp_* 淡紫家族已删除，改走 ?attr/appXxx（见 values/colors.xml 同处说明） -->

    <!-- 夜间模式 · 底栏为深色磨砂，未选中不能再用纯黑，改为浅灰白 -->
    <color name="nav_item_normal">#FFEBEBF5</color>
    <color name="nav_item_ripple">#26FFFFFF</color>

    <!-- 夜间模式 · 底部导航磨砂玻璃配色 -->
    <color name="nav_frost_tint">#AD1C1C1E</color>      <!-- 磨砂叠加：~68% 深灰，与日间同档去拖影强度 -->
    <color name="nav_frost_base">#661C1C1E</color>      <!-- 磨砂兜底底色：40% 深灰 -->
    <color name="nav_frost_sheen">#0FFFFFFF</color>     <!-- 顶部玻璃高光：极弱 -->
    <color name="nav_frost_stroke">#33FFFFFF</color>    <!-- 玻璃描边：20% 白 -->

    <!-- ===== 墨纸弹窗家族 · 夜间「墨玉鎏金」=====
         不是反色：宣纸的暖褐相保留，纸面压成墨玉底，描金与黛青按同色相提亮。
         看板娘插画（login_prompt_char / cancel_account_char）为彩色贴图，夜间不改色，只靠投影浮起。 -->
    <color name="gf_card_top">#FF2B2620</color>
    <color name="gf_card_bottom">#FF1F1A15</color>
    <color name="gf_ink">#FFF4EBD9</color>
    <color name="gf_ink_2">#FFCFBFA2</color>
    <color name="gf_body">#FFCFBFA2</color>
    <color name="gf_muted">#FF9A8B72</color>
    <color name="gf_hint">#FF7E7461</color>
    <color name="gf_gold">#FFC9A96E</color>              <!-- 描金在墨玉底上本身够亮，保持品牌色不动 -->
    <color name="gf_gold_soft">#FF7E6636</color>
    <color name="gf_cloud">#FF55482F</color>
    <color name="gf_wave">#FF4A3F2B</color>
    <color name="gf_action_top">#FFC8604E</color>       <!-- 朱砂在墨玉底上要提亮一档才压得住，白字仍约 5:1 -->
    <color name="gf_action_bottom">#FFA63E2E</color>
    <color name="gf_action_edge">#FFC8604E</color>
    <color name="gf_action_tint">#FF2A1D19</color>
    <color name="gf_progress">#FFB74F3B</color>
    <color name="gf_ghost_bg">#FF3A3227</color>          <!-- 次按钮要浮在墨玉纸面上，不能比卡片更暗 -->
    <color name="gf_inset">#FF241F19</color>
    <color name="gf_inset_text">#FFBFAE90</color>
    <color name="gf_pill">#FF332B21</color>
    <color name="gf_paper_in">#FF1B1712</color>
    <color name="gf_field_line">#FF5A4B32</color>
    <color name="gf_radio_off">#FF6B5B3E</color>
    <color name="gf_clear">#FF3A3227</color>
    <color name="gf_track">#FF332B21</color>
    <color name="gf_stamp_bg">#FFC2483A</color>
    <color name="gf_stamp_text">#FFFFF7EA</color>
    <color name="gf_seal">#FFE0806F</color>      <!-- 朱砂作文字 -->
    <!-- 弹窗危险操作文字：墨玉底上要提亮才读得清 -->
    <color name="ios_destructive">#FFE8796A</color>

    <!-- ===== 「宣纸」配色风格 · 夜间即弹窗已定稿的「墨玉鎏金」=====
         与日间同名，靠 uiMode 覆盖；别名到 gf_* 的项自动跟随弹窗那套取值。 -->
    <color name="xz_page_bg">#FF14110E</color>         <!-- 墨玉页底 -->
    <color name="xz_card_soft">#FF241F19</color>       <!-- 卡内芯片底：比卡片(#2B2620)更深一档 -->
    <color name="xz_separator">#FF3A3227</color>       <!-- 分隔线：暖褐细线 -->
    <color name="xz_accent_tint">#1FC8604E</color>      <!-- 夜间朱砂更亮一档，薄底跟着换 -->
    <color name="xz_accent_tint_strong">#33C8604E</color>
    <color name="xz_accent_stroke">#57C8604E</color>
    <color name="xz_nav_bg">#F01A1611</color>          <!-- 底栏磨砂兜底：94% 墨玉 -->
    <color name="xz_seg_track">#FF332B21</color>
    <color name="xz_seg_thumb">#FF4A3F2B</color>       <!-- 滑块要比轨道亮，否则选中段看不出来 -->
    <color name="xz_seg_text">#FFF4EBD9</color>        <!-- 滑块是深褐，选中文字改用纸白 -->
    <color name="xz_band_top">#FF241C16</color>        <!-- 顶部色带 · 墨玉转深檀褐 -->
    <color name="xz_band_center">#FF37271C</color>
    <color name="xz_band_bottom">#FF4A3423</color>
    <color name="xz_splash_bg">#FF14110E</color>
</resources>
